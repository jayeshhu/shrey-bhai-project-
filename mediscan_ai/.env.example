# MediScan AI - Environment Variables
# Copy this file to .env and fill in your values

# Flask Secret Key (generate a strong random key for production)
SECRET_KEY=your-secret-key-here-change-this

# AI API Configuration
# Supported: openai, gemini, groq
AI_PROVIDER=gemini
AI_API_KEY=your_api_key_here

# OpenAI specific (if using OpenAI)
OPENAI_MODEL=gpt-4o-mini

# Gemini specific (if using Google Gemini)
GEMINI_MODEL=gemini-1.5-flash

# Groq specific (if using Groq - free tier available)
GROQ_MODEL=llama-3.1-8b-instant

# Database (SQLite by default)
DATABASE_URL=sqlite:///instance/mediscan.db

# Upload settings
MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=uploads

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1
